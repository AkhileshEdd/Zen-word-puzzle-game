extends Node
## Loads data/levels.json (generated by tools/generate_levels.py) and hands out
## level definitions. Each entry is "BASE|ANSWER,ANSWER|BONUS,BONUS".

const DATA_PATH := "res://data/levels.json"

var chapter_size: int = 20
var _levels: Array = []
var _daily: Array = []


func _ready() -> void:
	var text := FileAccess.get_file_as_string(DATA_PATH)
	var parsed: Variant = JSON.parse_string(text)
	if typeof(parsed) != TYPE_DICTIONARY:
		push_error("Could not load level data from %s" % DATA_PATH)
		return
	_levels = parsed.get("levels", [])
	_daily = parsed.get("daily", [])
	chapter_size = int(parsed.get("chapter_size", 20))


func level_count() -> int:
	return _levels.size()


func daily_count() -> int:
	return _daily.size()


## Level numbers are 1-based. After the last level the late-game levels repeat
## so the game never runs out.
func get_level(level_num: int) -> Dictionary:
	if _levels.is_empty():
		return _decode("ZEN|ZEN|")
	var count := _levels.size()
	var idx := level_num - 1
	if idx >= count:
		var tail := maxi(1, count / 3)
		idx = count - tail + (idx - count) % tail
	return _decode(_levels[idx])


func get_daily(day: int) -> Dictionary:
	if _daily.is_empty():
		return get_level(1)
	return _decode(_daily[posmod(day, _daily.size())])


func _decode(entry: String) -> Dictionary:
	var parts := entry.split("|")
	var words := parts[1].split(",", false)
	var bonus := {}
	if parts.size() > 2:
		for w in parts[2].split(",", false):
			bonus[w] = true
	return {"base": parts[0], "words": Array(words), "bonus": bonus}
